APP_NAME="ScanAGBC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=IP_DEL_SERVIDOR_POSTGRES
DB_PORT=5432
DB_DATABASE=scan_agbc
DB_USERNAME=USUARIO_POSTGRES
DB_PASSWORD=PASSWORD_POSTGRES
DB_SSLMODE=prefer

# Modo recomendado para probar sin Docker ni Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=scan-agbc-cache-

# Redis es opcional. Usa estos valores solo si activas SESSION_DRIVER=redis,
# CACHE_STORE=redis o QUEUE_CONNECTION=redis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=scan-agbc-redis-
REDIS_DB=0
REDIS_CACHE_DB=1

SIOP_TRACKING_EVENTS_URL=
SIOP_TRACKING_EVENTS_TOKEN=
SIOP_TRACKING_EVENTS_TIMEOUT=12
SIOP_TRACKING_EVENTS_VERIFY_SSL=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
